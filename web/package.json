{
  "name": "slipway-web",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
