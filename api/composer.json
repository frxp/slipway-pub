{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "app/api",
    "type": "project",
    "description": "Laravel API with Sanctum token auth and a generated OpenAPI spec.",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "dedoc/scramble": "^0.13.52",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^13.4.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "openapi": [
            "@putenv DB_CONNECTION=sqlite",
            "@putenv DB_DATABASE=database/openapi.sqlite",
            "@php -r \"touch('database/openapi.sqlite');\"",
            "@php artisan migrate --force --quiet",
            "@php artisan scramble:export --path=openapi.json"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
